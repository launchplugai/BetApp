# The Odds API Integration
# Get your free API key at: https://the-odds-api.com
# Free tier: 500 requests/month
THE_ODDS_API_KEY=your_api_key_here

# OpenAI API (optional - for voice/TTS features)
OPENAI_API_KEY=your_openai_key_here

# Environment (Railway sets this automatically)
RAILWAY_ENVIRONMENT=development

# Deployment Base URL (for automation/health checks)
# Production: https://dna-production-b681.up.railway.app
# Local: http://localhost:8000
DNA_BASE_URL=http://localhost:8000
