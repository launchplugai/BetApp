# The Odds API Integration
# Get your free API key at: https://the-odds-api.com
# Free tier: 500 requests/month
THE_ODDS_API_KEY=your_api_key_here

# OpenAI API (optional - for voice/TTS features)
OPENAI_API_KEY=your_openai_key_here

# Environment (Railway sets this automatically)
RAILWAY_ENVIRONMENT=development

# Auth
# Required in production. Set locally for auth-capable development and testing.
JWT_SECRET_KEY=dev-local-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional admin override emails for /api/admin access.
# BEST tier is still sufficient without this.
ADMIN_EMAILS=

# App persistence database
# Local default falls back to sqlite:///./dna_bets.db when unset
# Postgres / Supabase examples:
# APP_DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/betapp
# APP_DATABASE_URL=postgresql+psycopg://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
APP_DATABASE_URL=

# Deployment Base URL (for automation/health checks)
# Production: https://dna-production-b681.up.railway.app
# Local: http://localhost:8000
DNA_BASE_URL=http://localhost:8000
