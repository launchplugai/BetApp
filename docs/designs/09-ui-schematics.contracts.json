{
  "$schema": "09-ui-schematics.contracts.json",
  "version": "1.0.0",
  "description": "Machine-checkable UI wiring contracts. Validated by tests/test_wiring_contracts.py.",

  "screens": {
    "landing": {
      "template": "screens/landing.html",
      "require_auth": false,
      "extends_base": true,
      "nav_visible": false
    },
    "auth": {
      "template": "screens/auth.html",
      "require_auth": false,
      "extends_base": true,
      "nav_visible": false
    },
    "onboarding": {
      "template": "screens/onboarding.html",
      "require_auth": true,
      "extends_base": false,
      "nav_visible": false
    },
    "dashboard": {
      "template": "screens/dashboard.html",
      "require_auth": true,
      "extends_base": true,
      "nav_visible": true
    },
    "browse": {
      "template": "screens/browse.html",
      "require_auth": true,
      "extends_base": true,
      "nav_visible": true
    },
    "builder": {
      "template": "screens/builder.html",
      "require_auth": true,
      "extends_base": true,
      "nav_visible": true
    },
    "history": {
      "template": "screens/history.html",
      "require_auth": true,
      "extends_base": true,
      "nav_visible": true
    },
    "protocol": {
      "template": "screens/protocol.html",
      "require_auth": true,
      "extends_base": true,
      "nav_visible": true
    },
    "notifications": {
      "template": "screens/notifications.html",
      "require_auth": true,
      "extends_base": true,
      "nav_visible": true
    }
  },

  "routes": {
    "app_entry": {
      "method": "GET",
      "path": "/app",
      "query_param": "screen",
      "default_screen": "dashboard"
    },
    "landing_alias": {
      "method": "GET",
      "path": "/",
      "renders": "screens/landing.html"
    },
    "evaluate": {
      "methods": ["POST"],
      "paths": ["/api/evaluate", "/app/evaluate"],
      "canonical": "/api/evaluate"
    },
    "legacy_redirects": [
      {"from": "/ui2", "to": "/app"},
      {"from": "/new", "to": "/app?screen=dashboard"}
    ]
  },

  "auth_contract": {
    "utility": "AUTH",
    "source": "/static/js/auth.js",
    "token_keys": {
      "access": "dna_auth_token",
      "refresh": "dna_refresh_token",
      "user": "dna_user",
      "remember": "dna_remember_me"
    },
    "required_methods": [
      "getAccessToken",
      "setTokens",
      "clearTokens",
      "isAuthenticated",
      "getAuthHeaders",
      "refreshAccessToken",
      "logout",
      "requireAuth",
      "fetch"
    ],
    "rules": {
      "no_raw_token_access": {
        "description": "Authenticated screens must NOT use raw sessionStorage.getItem('dna_auth_token')",
        "forbidden_pattern": "sessionStorage\\.getItem\\(['\"]dna_auth_token['\"]\\)",
        "applies_to_screens": ["dashboard", "browse", "builder", "history", "protocol", "notifications"]
      },
      "auth_gate_on_load": {
        "description": "Screens with require_auth=true get AUTH.requireAuth() from base.html",
        "mechanism": "base.html injects script block when require_auth is true"
      }
    }
  },

  "template_contract": {
    "base_template": "base.html",
    "extends_marker": "{% extends \"base.html\" %}",
    "required_blocks": ["body"],
    "optional_blocks": ["title", "extra_head", "nav", "scripts"],
    "context_variables": {
      "request": {"type": "Request", "always": true},
      "active_screen": {"type": "str", "always": true},
      "require_auth": {"type": "bool", "always": true},
      "git_sha": {"type": "str", "always": true}
    },
    "nav_hidden_screens": ["landing", "auth"]
  },

  "evaluate_contract": {
    "request": {
      "content_type": "application/json",
      "fields": {
        "input": {"type": "string", "required": true},
        "tier": {"type": "string", "required": false, "enum": ["GOOD", "BETTER", "BEST"]},
        "legs": {"type": "array", "required": false}
      }
    },
    "response": {
      "case_convention": "camelCase",
      "always_present": [
        "evaluationId",
        "sessionId",
        "createdAt",
        "evaluation",
        "evaluation.parlayId",
        "evaluation.inductor",
        "evaluation.metrics",
        "evaluation.correlations",
        "evaluation.dna",
        "evaluation.recommendation",
        "interpretation",
        "explain",
        "tier",
        "input",
        "input.betText",
        "input.tier",
        "persist",
        "persist.canSave",
        "persist.saveTarget",
        "persist.evaluationId",
        "_meta",
        "_meta.elapsedMs",
        "_meta.requestId"
      ],
      "optional": [
        "context",
        "nbaHeuristics",
        "primaryFailure",
        "deltaPreview",
        "signalInfo",
        "entities",
        "secondaryFactors",
        "humanSummary",
        "evaluatedParlay",
        "notableLegs",
        "finalVerdict",
        "gentleGuidance",
        "nextAction",
        "confidenceTrend",
        "groundingWarnings",
        "sherlockResult",
        "debugExplainability",
        "proofSummary",
        "structure",
        "delta",
        "groundingScore"
      ]
    },
    "error_contract": {
      "shape": {"error": {"code": "string", "message": "string", "details": "object"}},
      "description": "All error responses use this standard envelope"
    }
  },

  "protocol_contract": {
    "endpoints": {
      "list": {"method": "GET", "path": "/api/protocols"},
      "create": {"method": "POST", "path": "/api/protocols"},
      "detail": {"method": "GET", "path": "/api/protocols/{id}"},
      "update": {"method": "PATCH", "path": "/api/protocols/{id}"},
      "archive": {"method": "DELETE", "path": "/api/protocols/{id}"},
      "snapshot": {"method": "POST", "path": "/api/protocols/{id}/snapshot"},
      "feed": {"method": "GET", "path": "/api/protocols/{id}/feed"},
      "snapshot_v2": {"method": "GET", "path": "/api/protocols/{id}/snapshot-v2"}
    },
    "model_fields": ["id", "user_id", "sport", "title", "description", "status", "rules", "enabled", "visibility", "context", "created_at", "updated_at"],
    "rule_types": ["game_context", "team_state", "market", "risk_posture"]
  },

  "persistence_contract": {
    "bet_fields": ["id", "user_id", "evaluation_id", "session_id", "protocol_id", "sport", "game_ids", "legs", "grade", "risk", "confidence", "tags", "created_at"],
    "filterable_by": ["status", "sport", "grade", "protocol_id", "tag", "min_risk", "max_risk", "min_confidence", "start_date", "end_date", "q"]
  },

  "error_contract": {
    "shape": {"error": {"code": "string", "message": "string", "details": "object"}},
    "description": "ALL HTTP error responses use this standard envelope via exception handlers in main.py",
    "applies_to": "all_endpoints",
    "handler_location": "app/main.py"
  },

  "preferences_contract": {
    "description": "When authenticated, evaluate response includes preferencesApplied block",
    "response_field": "preferencesApplied",
    "shape": {
      "riskProfile": "string",
      "activeConstraints": ["string"],
      "constraintSummary": "object"
    },
    "condition": "Bearer token present in Authorization header"
  },

  "session_storage_contracts": [
    {"key": "dna_auth_token", "writer": "auth", "readers": ["AUTH.*"], "type": "string"},
    {"key": "dna_refresh_token", "writer": "auth", "readers": ["AUTH.*"], "type": "string"},
    {"key": "dna_user", "writer": "auth", "readers": ["dashboard", "nav"], "type": "object"},
    {"key": "dna_remember_me", "writer": "auth", "readers": ["AUTH.*"], "type": "string"},
    {"key": "dna_protocol_context", "writer": "browse", "readers": ["builder"], "type": "object"}
  ]
}
